# brainsentry-devops — deploy compose na VPS (31.97.240.217).
# Copie para .env (`scripts/setup.sh` faz isso e gera os segredos) e edite.
# O .env é gitignored; NUNCA comite valores reais.

# ---- Domínio (Caddy compartilhado da VPS) ----
# app.<ROOT_DOMAIN> → SPA   |  api.<ROOT_DOMAIN> → backend
# <ROOT_DOMAIN> e www redirecionam para app.  deploy.<ROOT_DOMAIN> → webhook.
ROOT_DOMAIN=brainsentry.com.br

# ---- Imagens (ghcr.io/integrall-tech, públicas) ----
# Fixe uma tag/SHA em produção; `latest` só se você acompanha o CI.
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
FALKORDB_IMAGE_TAG=v4.14.0

# ---- Postgres compartilhado (bluevix-postgres) ----
POSTGRES_ADMIN_CONTAINER=bluevix-postgres
POSTGRES_ADMIN_USER=bluevix
BRAINSENTRY_DB_HOST=bluevix-postgres
BRAINSENTRY_DB_PORT=5432
BRAINSENTRY_DB_NAME=brainsentry
BRAINSENTRY_DB_USER=brainsentry
BRAINSENTRY_DB_SSLMODE=disable
BRAINSENTRY_DB_PASSWORD=            # gerado por scripts/setup.sh

# ---- Redis compartilhado (bluevix-redis) ----
# Sem senha hoje. O db index (3) fica em config/config.production.yaml —
# não há env override para ele.
BRAINSENTRY_REDIS_HOST=bluevix-redis
BRAINSENTRY_REDIS_PORT=6379
BRAINSENTRY_REDIS_PASSWORD=

# ---- FalkorDB (container desta stack) ----
FALKORDB_PASSWORD=                  # gerado por scripts/setup.sh

# ---- Segurança ----
JWT_SECRET=                         # >=32 chars; o boot em production recusa vazio/default

# ---- LLM ----
# Chave do OpenRouter (a chain usa Anthropic/Gemini nativos quando as chaves
# nativas abaixo estão presentes).
BRAINSENTRY_AI_AGENTIC_MODEL_API_KEY=
# NÃO troque no chute: rode ./scripts/bench-llm.sh <modelo> antes. Modelos de
# raciocínio gastam o max_tokens pensando e devolvem JSON truncado — o backend
# então faz 3 retries e cada memória passa a levar ~45s.
BRAINSENTRY_AI_MODEL=google/gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- CORS ----
# O SPA é same-origin (nginx faz proxy de /api). Isto vale para consumidores
# externos da API em api.<ROOT_DOMAIN> (agentes MCP, CLI, TUI).
BRAINSENTRY_CORS_ORIGINS=https://app.brainsentry.com.br,https://brainsentry.com.br

# ---- Admin inicial (scripts/seed-admin.sh) ----
# Não há rota pública de registro: o primeiro usuário nasce por SQL.
BRAINSENTRY_ADMIN_EMAIL=edsonmartins2005@gmail.com
# Aspas obrigatórias em valores com espaço: os scripts fazem `source .env`,
# e sem elas o bash tenta executar a segunda palavra.
BRAINSENTRY_ADMIN_NAME="Edson Martins"
BRAINSENTRY_ADMIN_PASSWORD=         # gerado por scripts/setup.sh (anote!)

# ---- CD (docker-compose.webhook.yml) ----
DEPLOY_TOKEN=                       # gerado por scripts/setup.sh

# ---- Cloudflare (scripts/dns-sync.sh) ----
VPS_IP=31.97.240.217
CLOUDFLARE_API_TOKEN=               # ou ~/.env-projetos/api_token_cloudflare

# ---- Misc ----
TZ=America/Sao_Paulo
